{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DarkTide": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "Room": {
    "CommandQueueCapacity": 56,
    "QueryQueueCapacity": 8,
    "ReceiptCacheCapacity": 128,
    "ShutdownTimeout": "00:00:10",
    "JournalTimeout": "00:00:05"
  },
  "AllowedHosts": "*"
}
